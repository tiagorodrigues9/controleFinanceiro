FROM node:18-alpine

WORKDIR /app

# Copiar arquivos de dependência primeiro (cache de camadas)
COPY package.json package-lock.json ./

# Instalar dependências
RUN npm ci

# O código-fonte será montado via volume no docker-compose
# Não copiamos o código aqui para manter o hot-reload

EXPOSE 5000

CMD ["npm", "run", "dev"]
